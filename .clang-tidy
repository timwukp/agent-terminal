Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -cert-err33-c,
  -misc-no-recursion,
  -misc-include-cleaner,
  -readability-braces-around-statements,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-valist.Uninitialized,
  -bugprone-reserved-identifier,
  -cert-dcl37-c,
  -cert-dcl51-cpp
#
# Two checks above are disabled on evidence, not convenience:
#
# insecureAPI.DeprecatedOrUnsafeBufferHandling (67 hits) demands the C11
# Annex K `_s` functions — memcpy_s, snprintf_s. Annex K is optional and
# implemented by neither glibc nor macOS libc, so there is nothing to
# migrate to; every bounded memcpy/snprintf in the tree trips it. Bounds
# correctness is enforced instead by ASan+UBSan on every CI run and by the
# fuzz targets.
#
# valist.Uninitialized (3 hits, all correctly va_start/va_end-paired) is an
# x86_64-only false positive: verified clean under Apple clang and under
# clang-tidy 18 on arm64 Linux, firing only on x86_64 where va_list is a
# struct rather than a pointer.
#
# bugprone-reserved-identifier fires on the `#define _DARWIN_C_SOURCE`
# feature-test macros, which must use the reserved namespace by definition.
WarningsAsErrors: >
  clang-analyzer-*,
  bugprone-use-after-move,
  bugprone-dangling-handle,
  cert-str34-c
HeaderFilterRegex: 'src/.*'
