# systemd user unit for agent-terminald.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/systemd/agent-terminald.service ~/.config/systemd/user/
#   systemctl --user enable --now agent-terminald
#
# For sessions that must survive logout, also run:
#   loginctl enable-linger $USER

[Unit]
Description=agent-terminal session daemon
Documentation=https://github.com/timwukp/agent-terminal

[Service]
Type=simple
ExecStart=/usr/local/bin/agent-terminald -f
Restart=on-failure
RestartSec=1

# Hardening: the daemon needs only its runtime dir, session logs, and PTYs.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.agent-terminal
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
