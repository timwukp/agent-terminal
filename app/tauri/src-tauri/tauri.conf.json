{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-terminal",
  "version": "0.1.0",
  "identifier": "dev.agentterminal.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "agent-terminal",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
